# LangCross 商家店端 · 环境变量样例
# 复制为 .env 后按需修改；所有变量都有代码内默认值，本地零配置也能起。

# HTTP 监听地址
LC_ADDR=:8080

# PostgreSQL DSN
LC_DATABASE_URL=postgres://localhost:5432/langcross?sslmode=disable

# 对外基址：用于生成门店页 URL 与二维码内容（★ 物料印刷后不可变）
LC_PUBLIC_BASE_URL=http://localhost:8080

# token 签名密钥（★ 生产必须改成长随机串；不设 LC_DEV=1 时仍是此占位值将拒绝启动）
LC_SECRET=dev-insecure-secret-change-me

# 开发模式：1 = 验证码固定 000000 且响应回显 dev_code。
# ★ 只有显式设 1 才开启；删掉这行即生产模式（默认站在安全侧）。
LC_DEV=1

# Python OCR 微服务地址（PaddleOCR）。留空 = 走内置 stub（前端走手动保底）
LC_OCR_URL=

# 既有翻译链地址（自建翻译能力，生产首选）。留空 = 走 MyMemory（本地开发）
LC_TRANSLATE_URL=

# MyMemory 联系邮箱（可选）。仅当 LC_TRANSLATE_URL 为空时生效；填了免费配额更高
LC_MT_EMAIL=

# 支持语种（代码内置 10 种：zh/en/ja/ko/th/fr/es/de/pt/vi），无需配置；
# 新增语种只需在 server/internal/service/lang.go 的 SupportedLangs 登记
