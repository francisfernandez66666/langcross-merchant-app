# LangCross 商家店端 · 环境变量样例
# 复制为 .env 后按需修改；所有变量都有代码内默认值，本地零配置也能起。

# HTTP 监听地址
LC_ADDR=:8080

# PostgreSQL DSN
LC_DATABASE_URL=postgres://localhost:5432/langcross?sslmode=disable

# 对外基址：用于生成门店页 URL 与二维码内容（★ 物料印刷后不可变）
LC_PUBLIC_BASE_URL=http://localhost:8080

# token 签名密钥（生产必须改成长随机串）
LC_SECRET=dev-insecure-secret-change-me

# 开发模式：1 = 验证码固定 000000 且响应回显 dev_code
LC_DEV=1

# Python OCR 微服务地址（PaddleOCR）。留空 = 走内置 stub（前端走手动保底）
LC_OCR_URL=

# 既有翻译链地址。留空 = 走内置词典（本地演示用）
LC_TRANSLATE_URL=
