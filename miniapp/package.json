{
  "name": "langcross-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "LangCross 商家店端 · 小程序（Taro 4 + React）：客人端 / 店员端 / 商家后台三端",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "^4.0.0",
    "@tarojs/plugin-platform-h5": "^4.0.0",
    "@tarojs/plugin-platform-weapp": "^4.0.0",
    "@tarojs/react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tarojs/cli": "^4.0.0",
    "@tarojs/helper": "^4.0.0",
    "@tarojs/webpack5-runner": "^4.0.0",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.3"
  }
}
